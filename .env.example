# ---------------------------------------------------------------------------
# MeaningNonce — GenLayer Studio Next (Consensus v0.6)
# Copy this file to .env and set VITE_CONTRACT_ADDRESS.
# ---------------------------------------------------------------------------

# Deployed MeaningNonce contract on Studio Next.
VITE_CONTRACT_ADDRESS=0x8CB652d2a1d3E01DdD4eD1515F2c3F665c7D10b4

# Network. The defaults below are the announced Studio Next values; every
# consumer (reads, MetaMask, Transaction Kit) is built from this one set, so an
# RPC override can never sign a transaction for a different chain.
VITE_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
VITE_GENLAYER_CHAIN_ID=61997
VITE_GENLAYER_CHAIN_NAME=GenLayer Studio Next
VITE_GENLAYER_SYMBOL=GEN

# Explorer root, used only for outbound links.
# NOTE: the migration announcement lists https://explorer-studio-dev.genlayer.com/
# while a live deployment link resolved on https://explorer-studio-next.genlayer.com/.
# Open both against your contract and keep whichever renders it.
VITE_EXPLORER_URL=https://explorer-studio-dev.genlayer.com

# Public demo video. Shown as a button in the app's top bar.
# The URL below is also the built-in default in src/config.ts, so the button
# appears even if this variable is never set on the host.
VITE_DEMO_VIDEO_URL=https://www.youtube.com/watch?v=b9UQicWFo-k
